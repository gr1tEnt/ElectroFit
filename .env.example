# Copy this file to `.env` in the project root and set your own values.
# Never commit `.env` to Git.

# --- PostgreSQL (local Maven or Docker) ---
POSTGRES_USER=postgres
POSTGRES_PASSWORD=change-me-local-db-password
POSTGRES_DB=electrofit

# Local Spring Boot (mvn spring-boot:run)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/electrofit_db
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=change-me-local-db-password

# Docker Compose backend (hostname `db` inside the network)
# SPRING_DATASOURCE_URL=jdbc:postgresql://db:5432/electrofit

# --- JWT (required — min 32 characters) ---
JWT_SECRET=change-me-generate-a-random-string-at-least-32-chars
JWT_EXPIRATION_MS=3600000

# --- CORS (comma-separated frontend origins) ---
APP_CORS_ALLOWED_ORIGINS=http://localhost:3000,http://127.0.0.1:3000

# --- Email (Brevo — production / optional locally) ---
BREVO_API_KEY=
CONTACT_EMAIL=electrofit.support@gmail.com

# --- Frontend (Docker build + runtime) ---
NEXT_PUBLIC_API_URL=http://localhost:8080
